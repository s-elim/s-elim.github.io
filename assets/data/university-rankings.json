---
# Generated from _data/university_rankings.yml at build time. The rankings modal
# fetches this on first open instead of shipping 800 table rows in the homepage
# HTML, which kept the homepage DOM small.
layout: none
---
{% assign rk = site.data.university_rankings %}{% assign keys = "the,qs" | split: "," %}
{
{% for k in keys %}{% assign src = rk[k] %}"{{ k }}":[
{%- for e in src.entries -%}
["{{ e.rank }}","{{ e.name | replace: '\', '\\' | replace: '"', '\"' }}","{{ e.country | replace: '"', '\"' }}","{{ e.cross }}"]{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]{% unless forloop.last %},{% endunless %}
{% endfor %}
}

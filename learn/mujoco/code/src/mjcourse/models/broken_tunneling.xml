  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.01"/>
  <worldbody>
    <light pos="0 -1 2" dir="0 0.5 -1"/>
    <geom name="floor" type="plane" size="1 1 0.05" rgba=".86 .88 .86 1"/>
    <geom name="shelf" type="box" pos="0 0 0.5" size="0.3 0.3 0.003" rgba=".55 .45 .35 1"/>
    <body name="ball" pos="0 0 1.0">
      <freejoint/>
      <geom name="ball" type="sphere" size="0.01" mass="0.02" rgba=".85 .33 .1 1"/>
    </body>
  </worldbody>
  <keyframe><key qvel="0 0 -8 0 0 0"/></keyframe>
</mujoco>

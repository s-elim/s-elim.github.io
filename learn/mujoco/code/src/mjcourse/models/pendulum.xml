<!--
  pendulum.xml : a single hinge pendulum with an explicit inertial.

  The mass is placed with <inertial> rather than inferred from the geoms, so the
  dynamics are exactly those of a point mass m at distance L plus a small rotor
  inertia, and the closed-form checks in Level 0, 1 and 7 hold:

      I_pivot = m L^2 + I_c          (parallel-axis theorem, about the hinge)
      I_pivot * qacc = -m g L sin(q) - b qvel + tau

  The visual geoms carry no mass (an explicit <inertial> overrides geom inference
  under compiler inertiafromgeom="auto") and do not collide.
-->
<mujoco model="pendulum">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002"/>

  <default>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 -1 2" dir="0 1 -2"/>
    <geom name="floor" type="plane" size="1 1 0.05" pos="0 0 -0.2" rgba=".85 .87 .85 1"/>
    <geom name="mount" class="visual" type="box" size="0.04 0.04 0.04" pos="0 0 1" rgba=".3 .3 .3 1"/>

    <body name="pole" pos="0 0 1">
      <!-- Hinge about the world +y axis. By the right-hand rule, positive q
           carries the bob from (0, 0, -L) toward (-L sin q, 0, -L cos q), i.e. toward -x. -->
      <joint name="hinge" type="hinge" axis="0 1 0" damping="0"/>
      <inertial pos="0 0 -0.5" mass="1.0" diaginertia="1e-4 1e-4 1e-4"/>
      <geom name="rod" class="visual" type="capsule" fromto="0 0 0 0 0 -0.5" size="0.01" rgba=".5 .5 .5 1"/>
      <geom name="bob" class="visual" type="sphere" pos="0 0 -0.5" size="0.04" rgba=".85 .33 .1 1"/>
      <site name="tip" pos="0 0 -0.5" size="0.005"/>
    </body>
  </worldbody>

  <actuator>
    <!-- Torque source: ctrl is a torque in N m, clamped to ctrlrange. -->
    <motor name="torque" joint="hinge" gear="1" ctrlrange="-3 3"/>
  </actuator>

  <sensor>
    <jointpos name="angle" joint="hinge"/>
    <jointvel name="angvel" joint="hinge"/>
  </sensor>

  <keyframe>
    <key name="horizontal" qpos="1.5707963"/>
    <key name="small" qpos="0.2"/>
  </keyframe>
</mujoco>

<!--
  free_fall.xml : one ball, no floor. Nothing but gravity acts on it, so the
  exact solution z(t) = z0 - g t^2 / 2 is known and the integrator's error can be
  measured directly. Used in Level 0 and Level 1.
-->
<mujoco model="free_fall">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <worldbody>
    <light pos="0 -1 3" dir="0 0.3 -1"/>
    <body name="ball" pos="0 0 1">
      <freejoint name="ball"/>
      <geom name="ball" type="sphere" size="0.05" mass="1" rgba=".85 .33 .1 1"/>
    </body>
  </worldbody>
</mujoco>

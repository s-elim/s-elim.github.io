<!--
  franka_vla.xml : 7-DOF Franka Emika Panda manipulator with parallel jaw gripper
  for Vision-Language-Action (VLA) models in MuJoCo.

  Embodiment:
    7 revolute joints (j1..j7): shoulder yaw/pitch, arm roll, elbow pitch,
    forearm roll, wrist pitch, flange roll.
    Parallel 2-finger gripper with tendon-driven symmetric grip (0..0.08 m opening).

  Sensing for VLA:
    - overhead camera ("top"): 3rd-person global context
    - front camera ("front"): 3rd-person profile view
    - wrist camera ("gripper/wrist"): 1st-person egocentric view aligned with TCP
    - proprioception sensors: TCP position/orientation, joint positions, gripper opening

  Workspace:
    Tabletop with 3 colored manipulation objects (red, green, blue cubes),
    destination tray, and left/right placement zones.
-->
<mujoco model="franka_vla">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <headlight ambient=".15 .15 .15" diffuse=".35 .35 .35" specular=".1 .1 .1"/>
  </visual>

  <asset>
    <model name="arm" file="arm7_gripper.xml"/>
    <texture name="grid" type="2d" builtin="checker" rgb1=".62 .64 .62" rgb2=".56 .58 .56" width="256" height="256"/>
    <material name="grid" texture="grid" texrepeat="10 10"/>
  </asset>

  <default>
    <default class="object">
      <geom type="box" size="0.02 0.02 0.02" mass="0.08" friction="1 0.005 0.0001" condim="4"/>
    </default>
    <default class="tray">
      <geom type="box" rgba=".45 .47 .5 1" friction="1 0.005 0.0001"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.5 -0.8 1.8" dir="0 0.5 -1" diffuse=".55 .55 .55"/>
    <light pos="0.5 0.8 1.8" dir="0 -0.5 -1" diffuse=".25 .25 .25"/>
    <geom name="floor" type="plane" size="2 2 0.05" material="grid"/>

    <attach model="arm" body="link0" prefix=""/>

    <body name="red_cube" pos="0.45 0.12 0.02">
      <freejoint name="red_cube"/>
      <geom name="red_cube" class="object" rgba=".85 .15 .15 1"/>
    </body>
    <body name="green_cube" pos="0.55 -0.05 0.02">
      <freejoint name="green_cube"/>
      <geom name="green_cube" class="object" rgba=".15 .7 .25 1"/>
    </body>
    <body name="blue_cube" pos="0.42 -0.15 0.02">
      <freejoint name="blue_cube"/>
      <geom name="blue_cube" class="object" rgba=".15 .35 .85 1"/>
    </body>

    <body name="tray" pos="0.62 0.2 0">
      <geom name="tray_base" class="tray" size="0.08 0.08 0.005" pos="0 0 0.005"/>
      <geom name="tray_wall_px" class="tray" size="0.005 0.08 0.025" pos="0.075 0 0.03"/>
      <geom name="tray_wall_nx" class="tray" size="0.005 0.08 0.025" pos="-0.075 0 0.03"/>
      <geom name="tray_wall_py" class="tray" size="0.07 0.005 0.025" pos="0 0.075 0.03"/>
      <geom name="tray_wall_ny" class="tray" size="0.07 0.005 0.025" pos="0 -0.075 0.03"/>
      <site name="tray_center" pos="0 0 0.03" size="0.01" rgba="1 1 1 .3"/>
    </body>

    <site name="left_zone" pos="0.5 0.32 0.001" type="box" size="0.06 0.06 0.001" rgba=".2 .6 .9 .35"/>
    <site name="right_zone" pos="0.5 -0.32 0.001" type="box" size="0.06 0.06 0.001" rgba=".9 .6 .2 .35"/>

    <camera name="front" pos="1.35 0 0.75" xyaxes="0 1 0 -0.6357 0 0.7719" fovy="45"/>
    <camera name="side" pos="0.5 -1.0 0.6" xyaxes="1 0 0 0 0.4819 0.8762" fovy="45"/>
    <camera name="top" pos="0.5 0 1.4" xyaxes="0 -1 0 1 0 0" fovy="45"/>
  </worldbody>
</mujoco>

<!--
  arm2.xml : planar two-link arm moving in the vertical x-z plane.

  Both hinges rotate about -y, so a positive angle raises a link and the familiar
  planar formulas hold in the x-z plane with the base at the origin of `link1`:

      x = L1 cos(q1) + L2 cos(q1 + q2)
      z = L1 sin(q1) + L2 sin(q1 + q2)        L1 = 0.5 m, L2 = 0.4 m

  Inertias are given explicitly (uniform thin rods, I = m L^2 / 12 about the
  centre) and armature is zero, so the mass matrix computed by MuJoCo can be
  checked term by term against the textbook derivation in Level 7.

  Joint ranges are hardware stops: the shoulder cannot swing below -1.2 rad, so
  with no torque the arm comes to rest on that stop (Lesson 5.1 measures how far
  the soft limit lets it sink). Motor limits are about three times the worst-case
  gravity torque at the shoulder and nine times at the elbow (Lesson 5.1).
  The links do not collide with anything: this model is for kinematics,
  dynamics and control, not contact.
-->
<mujoco model="arm2">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002"/>

  <default>
    <joint type="hinge" axis="0 -1 0" damping="0.02"/>
    <geom contype="0" conaffinity="0" type="capsule"/>
    <motor gear="1"/>
  </default>

  <worldbody>
    <light pos="0 -2 3" dir="0 1 -1"/>
    <geom name="floor" type="plane" size="2 2 0.05" rgba=".85 .87 .85 1"/>
    <geom name="pedestal" type="cylinder" fromto="0 0 0 0 0 0.97" size="0.04" rgba=".3 .3 .3 1"/>

    <body name="link1" pos="0 0 1">
      <joint name="shoulder" range="-1.2 2.4"/>
      <inertial pos="0.25 0 0" mass="1.0" diaginertia="1e-4 0.0208333 0.0208333"/>
      <geom name="link1" fromto="0 0 0 0.5 0 0" size="0.025" rgba=".2 .35 .6 1"/>

      <body name="link2" pos="0.5 0 0">
        <joint name="elbow" range="-2.6 2.6"/>
        <inertial pos="0.2 0 0" mass="0.8" diaginertia="1e-4 0.0106667 0.0106667"/>
        <geom name="link2" fromto="0 0 0 0.4 0 0" size="0.02" rgba=".85 .33 .1 1"/>
        <site name="ee" pos="0.4 0 0" size="0.012" rgba="1 .8 0 1"/>
      </body>
    </body>

    <!-- A mocap body has no DOF and is moved by writing data.mocap_pos; used as an IK target marker. -->
    <body name="target" mocap="true" pos="0.6 0 1.3">
      <geom name="target" type="sphere" size="0.02" rgba=".1 .7 .3 .6"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="shoulder" joint="shoulder" ctrlrange="-25 25"/>
    <motor name="elbow" joint="elbow" ctrlrange="-15 15"/>
  </actuator>

  <sensor>
    <jointpos name="q_shoulder" joint="shoulder"/>
    <jointpos name="q_elbow" joint="elbow"/>
    <framepos name="ee_pos" objtype="site" objname="ee"/>
  </sensor>

  <keyframe>
    <key name="bent" qpos="0.6 -1.2"/>
  </keyframe>
</mujoco>

<!--
  double_pendulum.xml : two hinges in series, no damping, no actuators.

  A chaotic system with conserved energy. Used to show (a) integrator energy
  drift, (b) sensitivity to initial conditions, and (c) why "the simulation
  matches reality" is a statement about statistics for chaotic systems, not
  about single trajectories.
-->
<mujoco model="double_pendulum">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002"/>

  <default>
    <joint type="hinge" axis="0 1 0" damping="0"/>
    <geom contype="0" conaffinity="0"/>
  </default>

  <worldbody>
    <light pos="0 -1 2" dir="0 1 -2"/>
    <geom name="floor" type="plane" size="1 1 0.05" pos="0 0 -0.2" rgba=".85 .87 .85 1"/>
    <body name="link1" pos="0 0 1">
      <joint name="j1"/>
      <inertial pos="0 0 -0.3" mass="1.0" diaginertia="1e-4 1e-4 1e-4"/>
      <geom type="capsule" fromto="0 0 0 0 0 -0.3" size="0.012" rgba=".5 .5 .5 1"/>
      <geom type="sphere" pos="0 0 -0.3" size="0.03" rgba=".85 .33 .1 1"/>
      <body name="link2" pos="0 0 -0.3">
        <joint name="j2"/>
        <inertial pos="0 0 -0.3" mass="1.0" diaginertia="1e-4 1e-4 1e-4"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.3" size="0.012" rgba=".5 .5 .5 1"/>
        <geom type="sphere" pos="0 0 -0.3" size="0.03" rgba=".1 .45 .85 1"/>
        <site name="tip" pos="0 0 -0.3" size="0.005"/>
      </body>
    </body>
  </worldbody>

  <keyframe>
    <key name="release" qpos="2.0 0.5"/>
  </keyframe>
</mujoco>

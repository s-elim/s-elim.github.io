<!--
  incline.xml : a block resting on a ramp whose tilt is changed at run time.

  The ramp is a mocap body: it has no degrees of freedom and its pose is read
  from data.mocap_pos / data.mocap_quat at every step, so a lab tilts it by
  writing data.mocap_quat. (Rewriting model.body_quat of an ordinary static body
  is documented as unsafe: it invalidates precomputed collision structures.)
  After a tilt the block must be re-placed on the new surface.

  Coulomb prediction: the block starts to slide when tan(angle) exceeds the
  sliding friction coefficient of the contact. With equal geom priorities MuJoCo
  combines the two geoms' coefficients element-wise with max(), so the contact
  coefficient here is max(ramp, block) = the larger of the two values.
-->
<mujoco model="incline">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" cone="elliptic"/>

  <worldbody>
    <light pos="0 -1 2" dir="0 0.5 -1"/>
    <geom name="floor" type="plane" size="1 1 0.05" rgba=".86 .88 .86 1"/>
    <body name="ramp" mocap="true" pos="0 0 0.25">
      <geom name="ramp" type="box" size="0.4 0.15 0.01" rgba=".55 .45 .35 1" friction="0.4 0.005 0.0001"/>
    </body>
    <body name="block" pos="0 0 0.29">
      <freejoint name="block"/>
      <geom name="block" type="box" size="0.03 0.03 0.03" mass="0.2" rgba=".15 .35 .85 1" friction="0.4 0.005 0.0001"/>
    </body>
  </worldbody>
</mujoco>

<!--
  tutorial_tree.xml : a small kinematic tree to edit in Lesson 2.1.

  Things to try (one at a time, then press Run):
    1. Change the elbow joint's axis from "0 1 0" to "0 0 1". Which way does the arm swing now?
    2. Delete compiler angle="radian". What happens to the elbow range, and why?
    3. Give link2 euler="0 0 45". Which frames move: link2, its geoms, its site, its children?
    4. Move the "tip" site to pos="0 0 -0.3". Does the dynamics change? Do the sensors?
-->
<mujoco model="tutorial_tree">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002"/>

  <worldbody>
    <light pos="0 -1 2" dir="0 0.5 -1"/>
    <geom name="floor" type="plane" size="1 1 0.05" rgba=".86 .88 .86 1"/>

    <!-- A body's pos and orientation are relative to its parent body. -->
    <body name="link1" pos="0 0 0.8">
      <joint name="shoulder" type="hinge" axis="0 1 0" damping="0.05"/>
      <!-- fromto: the capsule runs from the first point to the second, in link1's frame. -->
      <geom name="upper" type="capsule" fromto="0 0 0 0 0 -0.3" size="0.025" rgba=".2 .35 .6 1"/>

      <body name="link2" pos="0 0 -0.3">
        <joint name="elbow" type="hinge" axis="0 1 0" range="-2 2" damping="0.05"/>
        <geom name="lower" type="capsule" fromto="0 0 0 0 0 -0.25" size="0.02" rgba=".85 .33 .1 1"/>
        <!-- Sites are frames with no physics: markers for sensors, targets and cameras. -->
        <site name="tip" pos="0 0 -0.25" size="0.012" rgba="1 .8 0 1"/>
      </body>
    </body>
  </worldbody>

  <sensor>
    <framepos name="tip_pos" objtype="site" objname="tip"/>
  </sensor>

  <keyframe>
    <key name="swing" qpos="1.0 -0.5"/>
  </keyframe>
</mujoco>
